# Blockscout's page and API behind one address (testnet/explorer/docker-compose.yml).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name localhost;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  location ~ ^/(api(?!-docs$)|socket|sitemap.xml) {
    proxy_pass http://blockscout-backend:5201;
  }
  location / {
    proxy_pass http://blockscout-frontend:3000;
  }
}
