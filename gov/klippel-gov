# ---------------------------------------------------------------- chain access

# Calls a view and prints what it returned as a flat JSON array of strings.
q() {
  local out
  out=$(cast call --json --rpc-url "$RPC" "$@" 2>&1) || die "could not read $2 from $1: $out"
  jq -c 'if type == "object" then .data else . end | [.. | scalars | tostring]' <<<"$out"
}

q1() { q "$@" | jq -r '.[0]'; }

# qa <array name> <address> <signature> [args...]: the same, into a bash array.
qa() {
  local -n _into=$1
  shift
  local out
  out=$(q "$@")
  mapfile -t _into < <(jq -r '.[]' <<<"$out")
}

addr_of() {
  jq -er --arg k "$1" '.[$k] | select(type == "string")' "$DEPLOYMENT" 2>/dev/null \
    || die "$DEPLOYMENT has no '$1'"
}

# The name the deployment file gives an address, or nothing.
name_of() {
  jq -r --arg a "${1,,}" 'to_entries[] | select((.value | tostring | ascii_downcase) == $a) | .key' \
    "$DEPLOYMENT" | head -n 1
}

label() {
  local name
  name=$(name_of "$1")
  if [ -n "$name" ]; then echo "$1 ($name)"; else echo "$1"; fi
}

address() {
  [[ $1 =~ ^0x[0-9a-fA-F]{40}$ ]] || die "'$1' is not an address"
  cast to-check-sum-address "$1"
}

# A contract or coin by its name in the deployment file, or an address.
resolve() {
  if [[ $1 == 0x* ]]; then address "$1"; else addr_of "$1"; fi
}

now() { cast block --rpc-url "$RPC" latest -f timestamp; }

# ---------------------------------------------------------------- reading and printing values

# to_units <amount> <decimals>: "1,50" or "1.50" into base units. A separator followed by exactly three digits
# is refused: 1.000 is one in English and a thousand in Portuguese.
to_units() {
  local s=${1//,/.}
  [[ $s =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "'$1' is not an amount. Write it like 1,50 or 1.50"
  [[ ! $s =~ \.[0-9]{3}$ ]] || die "'$1' is ambiguous. Write a thousand as 1000 and one as 1,00"
  cast parse-units "$s" "$2" 2>/dev/null || die "'$1' has more decimal places than the $2 this value keeps"
}

# from_units <base units> <decimals>: the same value back, with a comma and at least two decimal places.
from_units() {
  local v
  v=$(cast format-units "$1" "$2")
  [[ $v == *.* ]] || v+=".00"
  [[ $v =~ \.[0-9]$ ]] && v+="0"
  while [[ $v =~ \.[0-9]{3,}$ && $v == *0 ]]; do v=${v%0}; done
  echo "${v/./,}"
}

decimals_of() { q1 "$1" 'decimals()(uint8)'; }
brl() { echo "R\$ $(from_units "$1" "$2")"; }
centavos() { to_units "$1" 2; }
percent() { echo "$(from_units "$1" 2)%"; }

to_bps() {
  local bps
  bps=$(to_units "$1" 2)
  [ "$bps" -lt 10000 ] || die "'$1' per cent is not under 100"
  echo "$bps"
}

to_seconds() {
  [[ $1 =~ ^([0-9]{1,9})([smhd]?)$ ]] || die "'$1' is not a time. Write it like 90s, 30m, 2h or 7d"
  # 10#: a leading zero is still a decimal number, not an octal one.
  local n=$((10#${BASH_REMATCH[1]}))
  case "${BASH_REMATCH[2]}" in
    m) echo $((n * 60)) ;;
    h) echo $((n * 3600)) ;;
    d) echo $((n * 86400)) ;;
    *) echo "$n" ;;
  esac
}

duration() {
  local s=$1
  if [ "$s" -ne 0 ] && [ $((s % 86400)) -eq 0 ]; then echo "$((s / 86400)) d"
  elif [ "$s" -ne 0 ] && [ $((s % 3600)) -eq 0 ]; then echo "$((s / 3600)) h"
  elif [ "$s" -ne 0 ] && [ $((s % 60)) -eq 0 ]; then echo "$((s / 60)) min"
  else echo "$s s"; fi
}

when() {
  if [ "$1" = 0 ]; then echo never; else date -u -d "@$1" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "timestamp $1"; fi
}

uint() {
  [[ $1 =~ ^[0-9]+$ ]] || die "'$1' is not a whole number"
  echo "$1"
}

roles_text() {
  local r=$1 out=()
  [ $((r & 1)) -eq 0 ] || out+=(rider)
  [ $((r & 2)) -eq 0 ] || out+=(driver)
  [ $((r & 4)) -eq 0 ] || out+=(validator)
  if [ ${#out[@]} -eq 0 ]; then echo none; else (IFS=,; echo "${out[*]}"); fi
}

roles_bits() {
  local bits=0 r
  [ "$1" = none ] && { echo 0; return; }
  for r in ${1//,/ }; do
    case "$r" in
      rider) bits=$((bits | 1)) ;;
      driver) bits=$((bits | 2)) ;;
      validator) bits=$((bits | 4)) ;;
      *) die "'$r' is not a role. Use rider, driver, validator or none" ;;
    esac
  done
  echo "$bits"
}

credential_kind() {
  case "$1" in
    CNH | cnh) cast keccak "klippelgo.credential.CNH" ;;
    KYC | kyc) cast keccak "klippelgo.credential.KYC" ;;
    none) echo "$ZERO_32" ;;
    0x*) [[ $1 =~ ^0x[0-9a-fA-F]{64}$ ]] || die "'$1' is not a credential kind"; echo "$1" ;;
    *) die "'$1' is not a credential kind. Use CNH, KYC, none or a 32-byte hash" ;;
  esac
}

credential_name() {
  if [ "$1" = "$(credential_kind CNH)" ]; then echo CNH
  elif [ "$1" = "$(credential_kind KYC)" ]; then echo KYC
  elif [ "$1" = "$ZERO_32" ]; then echo none
  else echo "$1"; fi
}

# parse_kv "<allowed keys>" key=value...: into KV.
declare -A KV
parse_kv() {
  local allowed=" $1 " arg key
  shift
  KV=()
  for arg in "$@"; do
    [[ $arg == *=* ]] || die "'$arg' is not key=value. Keys:$allowed"
    key=${arg%%=*}
    [[ $allowed == *" $key "* ]] || die "'$key' is not one of:$allowed"
    KV[$key]=${arg#*=}
  done
  [ ${#KV[@]} -gt 0 ] || die "nothing to change. Keys:$allowed"
}

join() { local IFS=,; echo "[$*]"; }

# ---------------------------------------------------------------- signing and sending

WALLET=()
SIGNER=""

need_wallet() {
  [ -z "$SIGNER" ] || return 0
  # A multisig is the account that acts, and no key of this tool's signs for it.
  if [ -n "$SAFE" ]; then
    SIGNER=$SAFE
    return 0
  fi
  if [ -n "${KLIPPEL_GOV_WALLET:-}" ]; then
    read -ra WALLET <<<"$KLIPPEL_GOV_WALLET"
    # A key on a command line is in the shell's history and in `ps` for every user of the machine.
    if [ "$CHAIN" != 31337 ] && [[ " ${WALLET[*]} " =~ \ --(private-key|mnemonic|mnemonic-passphrase|password)[=\ ] ]]; then
      die "a raw key, mnemonic or password is accepted only on the local testnet (a password can come from --password-file). Use --ledger, --trezor, or a keystore: cast wallet import instituto --interactive, then KLIPPEL_GOV_WALLET='--account instituto'"
    fi
  elif [ "$CHAIN" = 31337 ]; then
    WALLET=(--private-key "$(cast wallet private-key --mnemonic "$ANVIL_MNEMONIC" --mnemonic-index 1)")
  else
    die "set KLIPPEL_GOV_WALLET to how cast should sign: --ledger, --trezor or --account <keystore name>"
  fi
  SIGNER=$(cast wallet address "${WALLET[@]}") || die "could not open the wallet (${KLIPPEL_GOV_WALLET:-local testnet account #1})"
}

confirm() {
  # With a multisig nothing is sent here: its owners are the ones who confirm.
  [ -z "$SAFE" ] || return 0
  [ "$YES" = 1 ] && return 0
  [ "$CHAIN" = 31337 ] && return 0
  [ -t 0 ] || die "refusing to send without a person to confirm. Pass --yes to send anyway"
  local answer
  read -r -p "Send this from $SIGNER on chain $CHAIN? Type yes: " answer
  [ "$answer" = yes ] || die "nothing sent"
}

# Turns the four bytes of a custom error in cast's output into its name. An error the council relays from a
# call it made (CallFailed) carries the inner one further on, so every hex value is looked at.
explain() {
  local data sig found=()
  for data in $(grep -oE '0x[0-9a-fA-F]{8,}' "$1" || true); do
    for sig in "${ERRORS[@]}"; do
      [ "$(cast sig "$sig")" != "${data:0:10}" ] || found+=("${sig%%(*}")
    done
    # Inside CallFailed's bytes the inner error starts after the index, offset and length words.
    if [ "${data:0:10}" = "$(cast sig 'CallFailed(uint256,bytes)')" ] && [ ${#data} -ge 210 ]; then
      for sig in "${ERRORS[@]}"; do
        [ "$(cast sig "$sig")" != "0x${data:202:8}" ] || found+=("${sig%%(*}")
      done
    fi
  done
  [ ${#found[@]} -eq 0 ] || echo "The contract refused it: $(printf '%s\n' "${found[@]}" | awk '!seen[$0]++' | paste -sd ' ' - | sed 's/ / -> /g')" >&2
}

# Whether this run only prepared a transaction for a multisig. Whoever called `send` stops there: there is
# no receipt to read and nothing happened yet.
prepared() { [ -n "$SAFE" ]; }

# prepare <address> <signature> [args...]: writes the transaction out for the owners of the multisig, as a
# file the Safe Transaction Builder loads and as the three values any other multisig asks for.
prepare() {
  local to=$1 data file
  shift
  data=$(cast calldata "$@") || die "could not encode $1"
  # A name no other run has, and a file that is only ever created: two transactions prepared in the same
  # second must not leave one file, and a file or link someone put there first must not be written through.
  file="${KLIPPEL_GOV_OUT:-.}/klippel-gov-$CHAIN-$(date -u +%Y%m%d-%H%M%S)-${data:2:8}-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n').json"
  (
    umask 077
    set -o noclobber
    jq -n --arg chain "$CHAIN" --arg to "$to" --arg data "$data" --arg safe "$SAFE" --arg what "$1" \
      --argjson at "$(date +%s)000" '{
        version: "1.0", chainId: $chain, createdAt: $at,
        meta: {name: "klippel-gov", description: $what, createdFromSafeAddress: $safe},
        transactions: [{to: $to, value: "0", data: $data, contractMethod: null, contractInputsValues: null}]
      }' >"$file"
  ) 2>/dev/null || die "could not create $file. Nothing was prepared"
  {
    echo "Nothing was sent. For the multisig $SAFE to do this, its owners approve one transaction:"
    echo "  to     $to"
    echo "  value  0"
    echo "  data   $data"
    echo "  check  $(cast keccak "$data")   (the hash of data: a short value for owners to compare)"
    echo "  file   $file   (in Safe: Apps, Transaction Builder, load this file)"
    echo "Every owner compares 'to' and 'data' with what the Safe page shows before approving."
    echo "Delete the file once the transaction is executed: loaded again, it would do the same thing again."
  } >&3
}

# send <address> <signature> [args...]: sends one transaction, waits for it and prints its receipt as JSON.
send() {
  local out errors
  if prepared; then
    prepare "$@"
    return 0
  fi
  errors=$(mktemp)
  # Into a file and then shown, not through tee: what tee writes may not be there yet when explain reads it.
  if ! out=$(cast send --json --rpc-url "$RPC" "${WALLET[@]}" --from "$SIGNER" "$@" 2>"$errors"); then
    # Newer versions of cast report the failure in their JSON on stdout; older ones on stderr.
    jq -r '.errors[]?.message' <<<"$out" 2>/dev/null >>"$errors" || echo "$out" >>"$errors"
    cat "$errors" >&2
    explain "$errors"
    rm -f "$errors"
    die "the transaction was not sent"
  fi
  rm -f "$errors"
  # Newer versions of cast wrap what they print in an envelope.
  out=$(jq -c 'if has("data") and has("schema_version") then .data else . end' <<<"$out")
  [ "$(jq -r '.status' <<<"$out")" = 0x1 ] || die "transaction $(jq -r '.transactionHash' <<<"$out") reverted"
  echo "$out"
}


# ---------------------------------------------------------------- the council

# The permissions, read once: PR role, PK kind (0 call, 1 playbook), PV via governor, PA active, PN approvals,
# PD delay, PT target, PS selector, PW argument word, PX its value.
PR=() PK=() PVIA=() PA=() PN=() PD=() PTG=() PS=() PW=() PX=()
PERMISSIONS_LOADED=0
load_permissions() {
  [ "$PERMISSIONS_LOADED" = 0 ] || return 0
  local count i v
  count=$(q1 "$COUNCIL" 'permissionCount()(uint256)')
  for ((i = 0; i < count; i++)); do
    qa v "$COUNCIL" "$PERMISSION_SIG" "$i"
    PR[i]=${v[0]} PK[i]=${v[1]} PVIA[i]=${v[2]} PA[i]=${v[3]} PN[i]=${v[4]} PD[i]=${v[5]}
    PTG[i]=${v[6]} PS[i]=${v[7]} PW[i]=${v[8]} PX[i]=${v[9]}
  done
  PERMISSIONS_LOADED=1
}

ROLE_NAMES=() ROLE_FLAGS=() ROLE_MEMBERS=()
load_roles() {
  [ ${#ROLE_NAMES[@]} = 0 ] || return 0
  local count i v
  count=$(q1 "$COUNCIL" 'roleCount()(uint256)')
  for ((i = 0; i < count; i++)); do
    v=$(cast call --json --rpc-url "$RPC" "$COUNCIL" 'role(uint8)((string,uint8,uint16))' "$i") || die "could not read role $i"
    ROLE_NAMES[i]=$(jq -r 'if type == "object" then .data else . end | .[0] | if type == "array" then .[0] else . end' <<<"$v")
    ROLE_FLAGS[i]=$(jq -r 'if type == "object" then .data else . end | .[0] | if type == "array" then .[1] else . end' <<<"$v")
    ROLE_MEMBERS[i]=$(jq -r 'if type == "object" then .data else . end | .[0] | if type == "array" then .[2] else . end' <<<"$v")
  done
}

# A role by its number, its name (any case) or its ASCII alias.
role_id() {
  local want=${1,,} i
  load_roles
  [[ $want =~ ^[0-9]+$ ]] && [ "$want" -lt ${#ROLE_NAMES[@]} ] && { echo "$want"; return; }
  for i in "${!ROLE_NAMES[@]}"; do
    [ "${ROLE_NAMES[$i],,}" != "$want" ] || { echo "$i"; return; }
  done
  for i in "${!ROLE_ALIASES[@]}"; do
    [ "${ROLE_ALIASES[$i]}" != "$want" ] || [ "$i" -ge ${#ROLE_NAMES[@]} ] || { echo "$i"; return; }
  done
  die "'$1' is not a role. Roles: $(for i in "${!ROLE_NAMES[@]}"; do printf '%s=%s ' "$i" "${ROLE_NAMES[$i]}"; done)"
}

role_name() { load_roles; echo "${ROLE_NAMES[$1]:-role $1}"; }

holds_role() { [ "$(q1 "$COUNCIL" 'hasRole(address,uint8)(bool)' "$1" "$2")" = true ]; }

# What a permission covers, in words.
permission_text() {
  local i=$1 name what
  if [ "${PK[$i]}" = 1 ]; then
    what="playbook $(playbook_name "$i")"
  else
    name=$(name_of "${PTG[$i]}")
    what="${name:-${PTG[$i]}}.$(fn_of "${name}" "${PS[$i]}")"
    [ "${PW[$i]}" = 0 ] || what+=" with argument ${PW[$i]} = $(cast to-dec "${PX[$i]}" 2>/dev/null || echo "${PX[$i]}")"
  fi
  echo "$what"
}

fn_of() {
  local name=$1 selector=$2 entry sig
  for entry in "${KNOWN_CALLS[@]}"; do
    sig=${entry#*|}
    if [ "${entry%%|*}" = "$name" ] && [ "$(cast sig "$sig")" = "$selector" ]; then echo "${sig%%(*}"; return; fi
  done
  echo "$selector"
}

needs_text() {
  local i=$1
  echo "$(role_name "${PR[$i]}"): ${PN[$i]} approval$([ "${PN[$i]}" = 1 ] || echo s)$([ "${PD[$i]}" = 0 ] && echo ", at once" || echo ", then $(duration "${PD[$i]}")")"
}

# The permission the calls in T and C fall under, among the active ones of a role the signer holds. All the
# calls of one action fall under one permission.
find_permission() {
  local i j match="" data word ok held=0
  load_permissions
  for i in "${!PR[@]}"; do
    [ "${PA[$i]}" = true ] && [ "${PK[$i]}" = 0 ] || continue
    ok=1
    for j in "${!T[@]}"; do
      data=${C[$j]}
      if [ "${T[$j],,}" != "${PTG[$i],,}" ] || [ "${data:0:10}" != "${PS[$i]}" ]; then ok=0; break; fi
      if [ "${PW[$i]}" != 0 ]; then
        word=0x${data:$((10 + 64 * (PW[i] - 1))):64}
        [ "$word" = "${PX[$i]}" ] || { ok=0; break; }
      fi
    done
    [ "$ok" = 1 ] || continue
    if holds_role "$SIGNER" "${PR[$i]}"; then echo "$i"; return; fi
    match=$i
  done
  [ -z "$match" ] || die "this is for $(role_name "${PR[$match]}") (permission $match), and $SIGNER is not a member of it"
  die "no permission of the council covers these calls. The board grants one with: klippel-gov team grant"
}

# The calls in T and C as the council takes them: [(target,data),...].
calls_arg() {
  local i out=()
  for i in "${!T[@]}"; do out+=("(${T[$i]},${C[$i]})"); done
  join "${out[@]}"
}

# An action's calls, read from the council's own event and checked against the hash it stored: T and C.
load_action_calls() {
  local id=$1 hash=$2 logs data decoded bytes
  logs=$(cast logs --json --rpc-url "$RPC" --from-block "$FROM_BLOCK" --address "$COUNCIL" "$ACTION_REQUESTED" "$(cast to-uint256 "$id")") \
    || die "could not read the council's events. If the node limits how far back it searches, set KLIPPEL_GOV_FROM_BLOCK"
  data=$(jq -r '.[0].data // empty' <<<"$logs")
  [ -n "$data" ] || die "action $id is not in the events since block $FROM_BLOCK. Set KLIPPEL_GOV_FROM_BLOCK to an earlier block"
  bytes=$(cast decode-abi --json 'f()(uint64,bytes)' "$data" | jq -r 'if type == "object" then .data else . end | .[1]')
  [ "$(cast keccak "$bytes")" = "$hash" ] || die "the calls the node reports for action $id do not match the hash the council stored. Do not trust this node"
  decoded=$(cast decode-abi --json "f()($CALLS_TYPE)" "$bytes" | jq -c 'if type == "object" then .data else . end | .[0]')
  mapfile -t T < <(jq -r '.[] | .[0]' <<<"$decoded")
  mapfile -t C < <(jq -r '.[] | .[1]' <<<"$decoded")
}

# Prints one call the way a member should read it.
describe_call() {
  local target=$1 data=$2 name entry sig fn args
  name=$(name_of "$target")
  if [ -z "$name" ]; then
    echo "      !! UNKNOWN CONTRACT $target"
    echo "         data $data"
    return
  fi
  for entry in "${KNOWN_CALLS[@]}"; do
    sig=${entry#*|}
    if [ "${entry%%|*}" = "$name" ] && [ "$(cast sig "$sig")" = "${data:0:10}" ]; then
      fn=${sig%%(*}
      args=$(cast decode-calldata "$sig" "$data" | paste -sd ' ' -)
      echo "      $name.$fn  $args"
      [ "$name" != ReleaseRegistry ] || describe_release_call "$fn" "$sig" "$data"
      [[ $SENSITIVE_CALLS != *" $fn "* ]] || echo "      !! $fn moves funds, rewires the protocol or changes who decides. Read every argument"
      return
    fi
  done
  echo "      !! UNKNOWN CALL on $name: selector ${data:0:10}"
  echo "         data $data"
}

# A release call as a director checks it before approving: the version as text and, for a publish, its contracts
# hash against the deployment file's code contracts and each APK hash on a line of its own.
describe_release_call() {
  local fn=$1 sig=$2 data=$3 decoded version code h
  decoded=$(cast decode-calldata --json "$sig" "$data" | jq -c 'if type == "object" then .data else . end')
  version=$(jq -r '.[0] | tostring' <<<"$decoded")
  echo "         release $(version_text "$version")"
  [ "$fn" = publish ] || return 0
  code=$(jq -r '.[1]' <<<"$decoded")
  if [ "$code" = "$(release_code_hash)" ]; then echo "         contracts hash matches the code contracts in $DEPLOYMENT"
  else echo "      !! contracts hash $code is NOT the one of the code contracts in $DEPLOYMENT: apps built from it would treat their release as unknown"; fi
  while read -r h; do
    [ -z "$h" ] || echo "         APK sha-256 $h"
  done < <(jq -r '.[2] | if type == "string" then (ltrimstr("[") | rtrimstr("]") | split(", ") | .[]) else .[] end' <<<"$decoded")
  echo "         Compare each APK hash with sha256sum of the APKs you built from the tag."
}

# An action: A the fields of action(id), A_STATE in words.
A=() A_APPROVERS=() A_STATE=""
STATUS_NAMES=(none pending executed cancelled)
load_action() {
  local id=$1 out t
  out=$(cast call --json --rpc-url "$RPC" "$COUNCIL" "$ACTION_SIG" "$(uint "$id")" 2>&1) || die "there is no action $id"
  out=$(jq -c 'if type == "object" then .data else . end | .[0]' <<<"$out")
  mapfile -t A < <(jq -r '.[0:5][] | tostring' <<<"$out")
  mapfile -t A_APPROVERS < <(jq -r '.[5][]' <<<"$out")
  load_permissions
  load_action_calls "$id" "${A[4]}"
  t=$(now)
  case "${A[1]}" in
    2) A_STATE=executed ;;
    3) A_STATE=cancelled ;;
    1)
      local have
      have=$(q1 "$COUNCIL" 'validApprovals(uint256)(uint256)' "$id")
      if [ "$t" -gt $((A[2] + 14 * 86400)) ]; then A_STATE="expired: it was not executed within 14 days of being ready"
      elif [ "$have" -lt "${PN[${A[0]}]}" ]; then A_STATE="waiting for approvals: $have of ${PN[${A[0]}]}"
      elif [ "$t" -lt "${A[2]}" ]; then A_STATE="approved, waiting until $(when "${A[2]}")"
      else A_STATE="ready to execute"; fi
      ;;
    *) A_STATE=unknown ;;
  esac
}

# A council that is not the guardian governs nothing: what it ran would revert, or worse, look like it worked.
check_guardian() {
  local g
  g=$(q1 "$GOV" 'guardian()(address)')
  [ "${g,,}" = "${COUNCIL,,}" ] || die "the council $COUNCIL is not the governor's guardian. Check the deployment file and klippel-gov status"
}

# What the views below print comes from these, read once in this shell and not again inside each $(...).
preload() { load_roles; load_permissions; load_playbooks; }

show_action() {
  local id=$1 i m mark
  preload
  load_action "$id"
  echo "Action $id"
  echo "  under     permission ${A[0]}: $(permission_text "${A[0]}")"
  echo "  needs     $(needs_text "${A[0]}")"
  echo "  by        $(label "${A[3]}")"
  echo "  state     $A_STATE"
  echo "  approvals"
  for m in "${A_APPROVERS[@]}"; do
    mark=""
    [ "$(q1 "$COUNCIL" 'suspended(address)(bool)' "$m")" = false ] || mark=" (suspended: does not count)"
    holds_role "$m" "${PR[${A[0]}]}" || mark=" (no longer in the role: does not count)"
    echo "    $(label "$m")$mark"
  done
  echo "  calls"
  for i in "${!T[@]}"; do describe_call "${T[$i]}" "${C[$i]}"; done
}

cmd_actions() {
  local count n=${1:-10} id first
  preload
  count=$(q1 "$COUNCIL" 'actionCount()(uint256)')
  [ "$count" != 0 ] || { echo "No actions yet."; return; }
  first=$((count - $(uint "$n")))
  [ "$first" -ge 0 ] || first=0
  for ((id = count - 1; id >= first; id--)); do
    load_action "$id"
    printf '%4s  %-44s  %s\n' "$id" "$A_STATE" "$(permission_text "${A[0]}")"
  done
}

# What `request` is about to send: T targets, C calldatas, TITLE what it does, LINES in plain words, WARNINGS
# what the person should think twice about.
T=() C=() TITLE="" LINES=() WARNINGS=()

add_call() {
  local target=$1
  shift
  T+=("$target")
  C+=("$(cast calldata "$@")") || die "could not encode $1"
}

# Sends a request for the calls in T and C, under the permission they fall under.
submit() {
  local perm out id i
  need_wallet
  # Read here, not inside $(...), so what is read stays for the lines printed below.
  load_permissions
  load_roles
  load_playbooks
  [ "$(q1 "$COUNCIL" 'suspended(address)(bool)' "$SIGNER")" = false ] || die "$SIGNER is suspended: it is not a member while suspended, and nothing it asks counts"
  check_guardian
  perm=$(find_permission)
  echo "$TITLE"
  [ ${#LINES[@]} -eq 0 ] || printf '  %s\n' "${LINES[@]}"
  echo "  calls"
  for i in "${!T[@]}"; do describe_call "${T[$i]}" "${C[$i]}"; done
  [ ${#WARNINGS[@]} -eq 0 ] || printf '  !! %s\n' "${WARNINGS[@]}"
  echo "  Under permission $perm, $(permission_text "$perm"). Needs $(needs_text "$perm")."
  confirm
  out=$(send "$COUNCIL" "request(uint32,$CALLS_TYPE)" "$perm" "$(calls_arg)")
  if prepared; then
    echo "Once the owners have executed it, klippel-gov actions shows the action and its number."
    return 0
  fi
  report_request "$out"
}

report_request() {
  local out=$1 id
  id=$(jq -r --arg t "$(cast sig-event "$ACTION_REQUESTED")" '.logs[] | select(.topics[0] == $t) | .topics[1]' <<<"$out")
  id=$(cast to-dec "$id")
  if jq -e --arg t "$(cast sig-event "$ACTION_EXECUTED")" 'any(.logs[]; .topics[0] == $t)' <<<"$out" >/dev/null; then
    echo "Done: action $id ran at once (transaction $(jq -r '.transactionHash' <<<"$out"))."
  else
    echo "Action $id is waiting (transaction $(jq -r '.transactionHash' <<<"$out"))."
    echo "  klippel-gov action $id      where it stands"
    echo "  klippel-gov approve $id     for another member of the role"
    echo "  klippel-gov execute $id     once it has its approvals and its delay is over"
  fi
}

cmd_approve() {
  local id=${1:-} m have
  need_wallet
  check_guardian
  show_action "$id"
  [ "${A[1]}" = 1 ] || die "action $id is $A_STATE"
  holds_role "$SIGNER" "${PR[${A[0]}]}" || die "$SIGNER is not a member of $(role_name "${PR[${A[0]}]}")"
  for m in "${A_APPROVERS[@]}"; do [ "${m,,}" != "${SIGNER,,}" ] || die "$SIGNER already approved action $id"; done
  echo "Approve action $id as $SIGNER."
  confirm
  send "$COUNCIL" "approve(uint256,$CALLS_TYPE)" "$id" "$(calls_arg)" >/dev/null
  ! prepared || return 0
  # The approval that makes an action ready runs it in the same transaction.
  if [ "$(cast call --json --rpc-url "$RPC" "$COUNCIL" "$ACTION_SIG" "$id" | jq -r 'if type == "object" then .data else . end | .[0][1] | tostring')" = 2 ]; then
    echo "Approved, and executed: it had its approvals and its delay was over."
  else
    echo "Approved."
  fi
}

cmd_execute() {
  local id=${1:-}
  need_wallet
  check_guardian
  show_action "$id"
  [ "$A_STATE" = "ready to execute" ] || die "action $id cannot be executed: it is $A_STATE"
  confirm
  send "$COUNCIL" "execute(uint256,$CALLS_TYPE)" "$id" "$(calls_arg)" >/dev/null
  ! prepared || return 0
  echo "Action $id is executed."
}

cmd_cancel() {
  local id=${1:-}
  need_wallet
  check_guardian
  show_action "$id"
  [ "${A[1]}" = 1 ] || die "action $id is $A_STATE"
  echo "Cancel action $id as $SIGNER."
  confirm
  send "$COUNCIL" 'cancel(uint256)' "$id" >/dev/null
  ! prepared || return 0
  echo "Action $id is cancelled."
}

# ---------------------------------------------------------------- playbooks

# The playbooks, from the council's events: PB_ID, PB_NAME, PB_CALLS (the encoded calls).
PB_ID=() PB_NAME=() PB_CALLS=()
load_playbooks() {
  [ ${#PB_ID[@]} = 0 ] || return 0
  local logs n i
  logs=$(cast logs --json --rpc-url "$RPC" --from-block "$FROM_BLOCK" --address "$COUNCIL" "$PLAYBOOK_GRANTED") \
    || die "could not read the council's events"
  n=$(jq 'length' <<<"$logs")
  for ((i = 0; i < n; i++)); do
    PB_ID+=("$(cast to-dec "$(jq -r ".[$i].topics[1]" <<<"$logs")")")
    local decoded
    decoded=$(cast decode-abi --json 'f()(string,bytes)' "$(jq -r ".[$i].data" <<<"$logs")" | jq -c 'if type == "object" then .data else . end')
    PB_NAME+=("$(jq -r '.[0]' <<<"$decoded")")
    PB_CALLS+=("$(jq -r '.[1]' <<<"$decoded")")
  done
}

playbook_name() {
  local i
  load_playbooks
  for i in "${!PB_ID[@]}"; do [ "${PB_ID[$i]}" != "$1" ] || { echo "${PB_NAME[$i]}"; return; }; done
  echo "#$1"
}

cmd_playbooks() {
  local i
  load_playbooks
  load_permissions
  [ ${#PB_ID[@]} -gt 0 ] || { echo "No playbooks."; return; }
  for i in "${!PB_ID[@]}"; do
    echo "${PB_NAME[$i]} (permission ${PB_ID[$i]}$([ "${PA[${PB_ID[$i]}]}" = true ] || echo ', REVOKED')), $(needs_text "${PB_ID[$i]}")"
  done
}

cmd_run() {
  local want=${1:-} i perm="" bytes decoded
  preload
  [ -n "$want" ] || die "run which playbook? See klippel-gov playbooks"
  load_playbooks
  load_permissions
  local matches=0
  for i in "${!PB_ID[@]}"; do
    [ "${PB_NAME[$i]}" = "$want" ] || [ "${PB_ID[$i]}" = "$want" ] || continue
    # Two active playbooks of one name (a revoke-release per release, say) must never be told apart by which
    # was granted last: the wrong one could revoke the wrong release.
    # A revoked one of the same name is passed over for an active one, and is what is found only when no
    # active one is, so the refusal below says it was revoked.
    if [ "${PA[${PB_ID[$i]}]}" = true ]; then
      matches=$((matches + 1))
    elif [ -n "$perm" ]; then
      continue
    fi
    perm=${PB_ID[$i]}
    bytes=${PB_CALLS[$i]}
  done
  [ -n "$perm" ] || die "there is no playbook '$want'. See klippel-gov playbooks"
  [ "$matches" -le 1 ] || die "$matches active playbooks are named '$want'. Run one by its number (klippel-gov playbooks)"
  [ "${PA[$perm]}" = true ] || die "playbook $want was revoked"
  [ "$(cast keccak "$bytes")" = "${PX[$perm]}" ] || die "the calls the node reports for playbook $want do not match the hash the council stored. Do not trust this node"
  decoded=$(cast decode-abi --json "f()($CALLS_TYPE)" "$bytes" | jq -c 'if type == "object" then .data else . end | .[0]')
  mapfile -t T < <(jq -r '.[] | .[0]' <<<"$decoded")
  mapfile -t C < <(jq -r '.[] | .[1]' <<<"$decoded")
  need_wallet
  holds_role "$SIGNER" "${PR[$perm]}" || die "playbook $want is for $(role_name "${PR[$perm]}"), and $SIGNER is not a member of it"
  echo "Run the playbook $want"
  echo "  calls"
  for i in "${!T[@]}"; do describe_call "${T[$i]}" "${C[$i]}"; done
  echo "  Needs $(needs_text "$perm")."
  confirm
  local out
  out=$(send "$COUNCIL" "request(uint32,$CALLS_TYPE)" "$perm" "$(calls_arg)")
  prepared || report_request "$out"
}

# ---------------------------------------------------------------- the team

cmd_team_show() {
  local i logs n m r holds who members=() suspended
  preload
  logs=$(cast logs --json --rpc-url "$RPC" --from-block "$FROM_BLOCK" --address "$COUNCIL" "$MEMBER_ROLE_SET") \
    || die "could not read the council's events"
  mapfile -t members < <(jq -r '.[].topics[1]' <<<"$logs" | sort -u)
  echo "Team council $COUNCIL, guardian of $GOV"
  for r in "${!ROLE_NAMES[@]}"; do
    local flags=""
    [ $((ROLE_FLAGS[r] & 1)) = 0 ] || flags+=", cancels any action"
    [ $((ROLE_FLAGS[r] & 2)) = 0 ] || flags+=", protected"
    echo "$r ${ROLE_NAMES[$r]} (${ROLE_MEMBERS[$r]} members$flags)"
    for m in "${members[@]}"; do
      who=$(cast parse-bytes32-address "$m")
      holds_role "$who" "$r" || continue
      suspended=$(q1 "$COUNCIL" 'suspended(address)(bool)' "$who")
      echo "    $(label "$who")$([ "$suspended" = false ] || echo '  SUSPENDED')"
    done
    for i in "${!PR[@]}"; do
      [ "${PR[$i]}" = "$r" ] && [ "${PA[$i]}" = true ] || continue
      printf '    %3s  %-58s %s\n' "$i" "$(permission_text "$i")" "${PN[$i]} approval$([ "${PN[$i]}" = 1 ] || echo s), $([ "${PD[$i]}" = 0 ] && echo 'at once' || duration "${PD[$i]}")"
    done
  done
}

build_team() {
  local what=${1:-} who role
  shift || true
  case "$what" in
    add | remove)
      who=$(address "${1:-}")
      role=$(role_id "${2:-}")
      local holds=$([ "$what" = add ] && echo true || echo false)
      if [ "$holds" = true ]; then holds_role "$who" "$role" && die "$who is already in $(role_name "$role")" || true
      else holds_role "$who" "$role" || die "$who is not in $(role_name "$role")"; fi
      add_call "$COUNCIL" 'setMemberRole(address,uint8,bool)' "$who" "$role" "$holds"
      TITLE="$([ "$what" = add ] && echo Add || echo Remove) $who $([ "$what" = add ] && echo to || echo from) $(role_name "$role")"
      [ "$what" != add ] || WARNINGS+=("Check the address with its owner by voice or in person: a pasted address is the easiest thing to swap.")
      ;;
    suspend | unsuspend)
      who=$(address "${1:-}")
      local s=$([ "$what" = suspend ] && echo true || echo false)
      [ "$(q1 "$COUNCIL" 'suspended(address)(bool)' "$who")" != "$s" ] || die "$who is already ${what}ed"
      add_call "$COUNCIL" 'setSuspended(address,bool)' "$who" "$s"
      TITLE="${what^} $who"
      [ "$what" = unsuspend ] || LINES+=("At once, nothing $who requested or approved counts, including approvals given to pending actions.")
      ;;
    grant)
      role=$(role_id "${1:-}")
      local fn=${2:-} target sig="" entry approvals=1 delay=0 via=governor word=0 value=$ZERO_32 arg key
      [ -n "$fn" ] || die "team grant <role> <Contract.function> [approvals=] [delay=] [via=] [arg=<n>:<value>]"
      shift 2
      target=$(addr_of "${fn%%.*}")
      for entry in "${KNOWN_CALLS[@]}"; do
        [ "${entry%%|*}.$(sed 's/(.*//' <<<"${entry#*|}")" != "$fn" ] || sig=${entry#*|}
      done
      [ -n "$sig" ] || die "'$fn' is not a call klippel-gov knows. Known: $(for entry in "${KNOWN_CALLS[@]}"; do printf '%s.%s ' "${entry%%|*}" "$(sed 's/(.*//' <<<"${entry#*|}")"; done)"
      [ "${fn%%.*}" != TeamCouncil ] || via=council
      [ "$fn" != PBACGovernor.proposeGuardian ] || via=council
      [[ $fn != IdentityStore.attest && $fn != IdentityStore.revoke ]] || via=council
      for arg in "$@"; do
        key=${arg%%=*}
        case "$key" in
          approvals) approvals=$(uint "${arg#*=}") ;;
          delay) delay=$(to_seconds "${arg#*=}") ;;
          via) via=${arg#*=}; [[ $via == governor || $via == council ]] || die "via is governor or council" ;;
          arg) word=$(uint "$(cut -d: -f1 <<<"${arg#*=}")"); value=$(cast to-uint256 "$(cut -d: -f2- <<<"${arg#*=}")") ;;
          *) die "'$key' is not one of: approvals delay via arg" ;;
        esac
      done
      add_call "$COUNCIL" 'grant((uint8,uint8,bool,bool,uint8,uint32,address,bytes4,uint16,bytes32))' \
        "($role,0,$([ "$via" = governor ] && echo true || echo false),true,$approvals,$delay,$target,$(cast sig "$sig"),$word,$value)"
      TITLE="Let $(role_name "$role") call $fn"
      LINES+=("With $approvals approval$([ "$approvals" = 1 ] || echo s) and $([ "$delay" = 0 ] && echo 'no delay' || echo "a delay of $(duration "$delay")"), run as $([ "$via" = governor ] && echo 'the governor' || echo 'the council').")
      [ "$word" = 0 ] || LINES+=("Only when argument $word is $value.")
      ;;
    revoke-permission)
      local id
      id=$(uint "${1:-}")
      load_permissions
      [ -n "${PR[$id]:-}" ] || die "there is no permission $id"
      add_call "$COUNCIL" 'revokePermission(uint32)' "$id"
      TITLE="Take from $(role_name "${PR[$id]}") permission $id, $(permission_text "$id")"
      ;;
    set)
      local id approvals delay arg
      id=$(uint "${1:-}")
      shift
      load_permissions
      [ -n "${PR[$id]:-}" ] || die "there is no permission $id"
      approvals=${PN[$id]} delay=${PD[$id]}
      parse_kv "approvals delay" "$@"
      [ -z "${KV[approvals]:-}" ] || approvals=$(uint "${KV[approvals]}")
      [ -z "${KV[delay]:-}" ] || delay=$(to_seconds "${KV[delay]}")
      add_call "$COUNCIL" 'setApprovalsAndDelay(uint32,uint8,uint32)' "$id" "$approvals" "$delay"
      TITLE="Change what permission $id needs: $(permission_text "$id")"
      LINES+=("approvals: ${PN[$id]} -> $approvals; delay: $(duration "${PD[$id]}") -> $(duration "$delay")")
      ;;
    create-role)
      local name=${1:-} flags=0 f
      [ -n "$name" ] || die "team create-role <name> [cancels-any] [protected]"
      shift
      for f in "$@"; do
        case "$f" in cancels-any) flags=$((flags | 1)) ;; protected) flags=$((flags | 2)) ;; *) die "'$f' is cancels-any or protected" ;; esac
      done
      add_call "$COUNCIL" 'createRole(string,uint8)' "$name" "$flags"
      TITLE="Create the role $name"
      ;;
    *) die "team add | remove | suspend | unsuspend | grant | revoke-permission | set | create-role. See klippel-gov help" ;;
  esac
}

build_request() {
  local what=${1:-}
  [ -n "$what" ] || die "request what? See klippel-gov help"
  shift
  local REG STK ESC who kind token d cur new key bps collector seconds
  REG=$(addr_of IdentityStore)
  STK=$(addr_of StakeVault)
  ESC=$(addr_of RideEscrow)
  case "$what" in
    block | unblock)
      who=$(address "${1:-}")
      new=$([ "$what" = block ] && echo true || echo false)
      [ "$(q1 "$REG" 'blocked(address)(bool)' "$who")" != "$new" ] || die "$who is already ${what}ed"
      add_call "$REG" 'setBlocked(address,bool)' "$who" "$new"
      TITLE="${what^} $who"
      if [ "$what" = block ]; then
        LINES+=("Block $who: it passes no policy, so it opens and accepts no ride, judges no dispute and attests no map.")
        LINES+=("Rides it has under way still settle, and its stake can still leave.")
        [ "$(q1 "$REG" 'registeredAt(address)(uint64)' "$who")" != 0 ] || WARNINGS+=("$who never registered. Check the address.")
        [ "$(q1 "$REG" 'trustedAttester(address)(bool)' "$who")" = false ] || WARNINGS+=("$who is a trusted attester, and a block does not stop it issuing or revoking credentials. Request 'attester $who off' as well.")
        WARNINGS+=("A block follows an address, not a person: a rider needs no credential and can register another address. To stop a driver at once, revoke the CNH (klippel-gov cnh revoke).")
      else
        LINES+=("Unblock $who: the policies apply to it again as to anyone.")
      fi
      ;;
    attester)
      who=$(address "${1:-}")
      case "${2:-}" in on) new=true ;; off) new=false ;; *) die "attester <address> on|off" ;; esac
      add_call "$REG" 'setAttester(address,bool)' "$who" "$new"
      if [ "$new" = true ]; then
        TITLE="Trust $who as an attester"
        LINES+=("$who may issue and revoke credentials, among them the CNH a driver needs to accept rides.")
      else
        TITLE="Stop trusting $who as an attester"
        LINES+=("Every credential $who issued stops counting at once, and it can issue no more.")
        WARNINGS+=("Drivers whose CNH came from this attester can no longer accept rides until another attester approves them.")
      fi
      ;;
    tax)
      bps=$(to_bps "${1:-}")
      qa cur "$ESC" 'taxBps()(uint16)'
      collector=$(q1 "$ESC" 'taxCollector()(address)')
      [ -z "${2:-}" ] || collector=$(address "$2")
      [ "$bps" = 0 ] || [ "$collector" != "$ZERO_ADDRESS" ] || die "a tax needs a collector: request tax <percent> <collector>"
      add_call "$ESC" 'setTax(uint16,address)' "$bps" "$collector"
      TITLE="Set the tax to $(percent "$bps") of each fare"
      LINES+=("Tax: $(percent "${cur[0]}") -> $(percent "$bps") of each fare, paid to $collector. Rides already open keep theirs.")
      # Limit L13: a collector that cannot receive the coin blocks the settlement of the rides that name it.
      [ "$(cast code --rpc-url "$RPC" "$collector")" = 0x ] || WARNINGS+=("The collector is a contract. If it cannot receive the coin, its tax waits in the escrow until it withdraws it. Name a plain account.")
      ;;
    token)
      token=$(resolve "${1:-}")
      shift
      d=$(decimals_of "$token")
      qa cur "$ESC" 'tokenConfig(address)(uint256,uint256,uint256)' "$token"
      parse_kv "fee riderBond driverBond" "$@"
      new=("${cur[@]}")
      [ -z "${KV[fee]:-}" ] || new[0]=$(to_units "${KV[fee]}" "$d")
      [ -z "${KV[riderBond]:-}" ] || new[1]=$(to_units "${KV[riderBond]}" "$d")
      [ -z "${KV[driverBond]:-}" ] || new[2]=$(to_units "${KV[driverBond]}" "$d")
      add_call "$ESC" 'setToken(address,uint256,uint256,uint256)' "$token" "${new[@]}"
      TITLE="Set the fee and bonds of $(label "$token")"
      LINES+=("Coin $(label "$token"), $d decimals. Rides already open keep theirs.")
      LINES+=("  fee to Instituto Klippel: $(brl "${cur[0]}" "$d") -> $(brl "${new[0]}" "$d")")
      LINES+=("  rider bond:               $(brl "${cur[1]}" "$d") -> $(brl "${new[1]}" "$d")")
      LINES+=("  driver bond:              $(brl "${cur[2]}" "$d") -> $(brl "${new[2]}" "$d")")
      [ "${new[0]}" != 0 ] || WARNINGS+=("A fee of zero takes the coin off the allow-list: no new ride can be paid in it.")
      # Limit L10: the escrow assumes a plain ERC-20.
      [ "${cur[0]}" != 0 ] || WARNINGS+=("This puts a new coin on the allow-list. It must be a plain ERC-20: the escrow refuses deposits that arrive short, and a coin that rebases or calls back still breaks it. Set a cap for it as well.")
      ;;
    tariff)
      local FARES
      FARES=$(addr_of FareGuide)
      qa cur "$FARES" 'tariff()(uint32,uint32,uint32,uint32,uint16,uint16)'
      parse_kv "base perKm perMinute minimum riderRange driverDiscount" "$@"
      new=("${cur[@]}")
      [ -z "${KV[base]:-}" ] || new[0]=$(centavos "${KV[base]}")
      [ -z "${KV[perKm]:-}" ] || new[1]=$(centavos "${KV[perKm]}")
      [ -z "${KV[perMinute]:-}" ] || new[2]=$(centavos "${KV[perMinute]}")
      [ -z "${KV[minimum]:-}" ] || new[3]=$(centavos "${KV[minimum]}")
      [ -z "${KV[riderRange]:-}" ] || new[4]=$(to_bps "${KV[riderRange]}")
      [ -z "${KV[driverDiscount]:-}" ] || new[5]=$(to_bps "${KV[driverDiscount]}")
      add_call "$FARES" 'setTariff((uint32,uint32,uint32,uint32,uint16,uint16))' "($(IFS=,; echo "${new[*]}"))"
      TITLE="Change the tariff"
      LINES+=("  base:             $(brl "${cur[0]}" 2) -> $(brl "${new[0]}" 2)")
      LINES+=("  per km:           $(brl "${cur[1]}" 2) -> $(brl "${new[1]}" 2)")
      LINES+=("  per minute:       $(brl "${cur[2]}" 2) -> $(brl "${new[2]}" 2)")
      LINES+=("  minimum:          $(brl "${cur[3]}" 2) -> $(brl "${new[3]}" 2)")
      LINES+=("  rider range:      $(percent "${cur[4]}") -> $(percent "${new[4]}") either side of the recommended price")
      LINES+=("  driver discount:  $(percent "${cur[5]}") -> $(percent "${new[5]}") under the rider's price")
      ;;
    native-coin-price)
      local FARES
      FARES=$(addr_of FareGuide)
      new=$(centavos "${1:-}")
      cur=$(q1 "$FARES" 'nativeCoinCentavos()(uint256)')
      add_call "$FARES" 'setNativeCoinPrice(uint256)' "$new"
      TITLE="Set the native coin's price to $(brl "$new" 2)"
      LINES+=("One native coin: $(brl "$cur" 2) -> $(brl "$new" 2). It only changes the infrastructure cost the app shows.")
      ;;
    completion-timeout)
      seconds=$(to_seconds "${1:-}")
      cur=$(q1 "$ESC" 'completionTimeout()(uint64)')
      add_call "$ESC" 'setCompletionTimeout(uint64)' "$seconds"
      TITLE="Set the completion timeout to $(duration "$seconds")"
      LINES+=("How long a driver's receipt stands before anyone may settle the ride: $(duration "$cur") -> $(duration "$seconds"), for rides opened from now on.")
      [ "$seconds" -ge 300 ] || WARNINGS+=("Under five minutes leaves a rider little time to contest a receipt before the driver is paid.")
      ;;
    dispute-periods)
      local COURT commit reveal
      COURT=$(addr_of DisputeCourt)
      commit=$(to_seconds "${1:-}")
      reveal=$(to_seconds "${2:-}")
      qa cur "$COURT" 'commitPeriod()(uint64)'
      add_call "$COURT" 'setPeriods(uint64,uint64)' "$commit" "$reveal"
      TITLE="Set the dispute periods to $(duration "$commit") and $(duration "$reveal")"
      LINES+=("Jurors commit for $(duration "$commit") (now $(duration "${cur[0]}")) and reveal for $(duration "$reveal") (now $(duration "$(q1 "$COURT" 'revealPeriod()(uint64)')")).")
      ;;
    unbonding-period)
      seconds=$(to_seconds "${1:-}")
      [ "$seconds" -le $((30 * 86400)) ] || die "the stake vault holds nobody's stake longer than 30 days"
      cur=$(q1 "$STK" 'unbondingPeriod()(uint64)')
      add_call "$STK" 'setUnbondingPeriod(uint64)' "$seconds"
      TITLE="Set the unbonding period to $(duration "$seconds")"
      LINES+=("How long stake waits before it can leave: $(duration "$cur") -> $(duration "$seconds"). It applies to every unstake requested from now on.")
      ;;
    beneficiary)
      local VAULT
      VAULT=$(addr_of FeeVault)
      who=$(address "${1:-}")
      [ "$who" != "$ZERO_ADDRESS" ] || die "the beneficiary cannot be the zero address: the fees would be burnt"
      add_call "$VAULT" 'setBeneficiary(address)' "$who"
      TITLE="Send the fees to $who"
      LINES+=("FeeVault.sweep pays the R\$ 1,00 per ride to $who instead of $(q1 "$VAULT" 'beneficiary()(address)').")
      ;;
    policy)
      local fn entry sig="" target stake
      fn=${1:-}
      shift || true
      for entry in "${POLICIES[@]}"; do [ "${entry%%|*}" != "$fn" ] || sig=${entry#*|}; done
      [ -n "$sig" ] || die "'$fn' is not a function a policy guards. One of: $(printf '%s ' "${POLICIES[@]%%|*}")"
      target=$(addr_of "${fn%%.*}")
      stake=$(q1 "$STK" 'stakeToken()(address)')
      d=$(decimals_of "$stake")
      qa cur "$GOV" 'policy(address,bytes4)((bool,uint8,uint16,uint32,uint256,bytes32))' "$target" "$(cast sig "$sig")"
      parse_kv "enabled roles minScore minAccountAge minStake credential" "$@"
      new=("${cur[@]}")
      if [ -n "${KV[enabled]:-}" ]; then
        [[ ${KV[enabled]} == true || ${KV[enabled]} == false ]] || die "enabled is true or false"
        new[0]=${KV[enabled]}
      fi
      [ -z "${KV[roles]:-}" ] || new[1]=$(roles_bits "${KV[roles]}")
      [ -z "${KV[minScore]:-}" ] || new[2]=$(to_units "${KV[minScore]}" 2)
      [ -z "${KV[minAccountAge]:-}" ] || new[3]=$(to_seconds "${KV[minAccountAge]}")
      [ -z "${KV[minStake]:-}" ] || new[4]=$(to_units "${KV[minStake]}" "$d")
      [ -z "${KV[credential]:-}" ] || new[5]=$(credential_kind "${KV[credential]}")
      [ "${new[2]}" -le 500 ] || die "a score is at most 5,00"
      add_call "$GOV" 'setPolicy(address,bytes4,(bool,uint8,uint16,uint32,uint256,bytes32))' "$target" "$(cast sig "$sig")" "($(IFS=,; echo "${new[*]}"))"
      TITLE="Change who may call $fn"
      LINES+=("  enabled:          ${cur[0]} -> ${new[0]}")
      LINES+=("  roles (any of):   $(roles_text "${cur[1]}") -> $(roles_text "${new[1]}")")
      LINES+=("  minimum score:    $(from_units "${cur[2]}" 2) -> $(from_units "${new[2]}" 2)")
      LINES+=("  minimum age:      $(duration "${cur[3]}") -> $(duration "${new[3]}")")
      LINES+=("  minimum stake:    $(brl "${cur[4]}" "$d") -> $(brl "${new[4]}" "$d")")
      LINES+=("  credential:       $(credential_name "${cur[5]}") -> $(credential_name "${new[5]}")")
      [ "${new[0]}" = true ] || WARNINGS+=("A disabled policy lets nobody call $fn.")
      ;;
    cap)
      token=$(resolve "${1:-}")
      d=$(decimals_of "$token")
      new=$(to_units "${2:-}" "$d")
      cur=$(q1 "$ESC" 'cap(address)(uint256)' "$token")
      add_call "$ESC" 'setCap(address,uint256)' "$token" "$new"
      TITLE="Set the escrow's cap on $(label "$token") to $([ "$new" = 0 ] && echo 'no limit' || brl "$new" "$d")"
      LINES+=("The most of this coin the escrow holds at once: $([ "$cur" = 0 ] && echo 'no limit' || brl "$cur" "$d") -> $([ "$new" = 0 ] && echo 'no limit' || brl "$new" "$d"). It holds $(brl "$(q1 "$ESC" 'held(address)(uint256)' "$token")" "$d") now.")
      LINES+=("It bounds what is lost if the coin's issuer freezes the escrow. Once reached, no ride opens or is accepted in this coin until others settle.")
      ;;
    guardian)
      who=$(address "${1:-}")
      [ "${who,,}" != "${GOV,,}" ] || die "the governor cannot be its own guardian"
      add_call "$GOV" 'proposeGuardian(address)' "$who"
      TITLE="Hand the guardian's seat to $who"
      LINES+=("$who becomes the guardian when it accepts. Until then nothing changes, and another request can name someone else.")
      WARNINGS+=("The guardian governs everything. Whoever holds it can take this council's place for good.")
      ;;
    map-quorum)
      local MAPS
      MAPS=$(addr_of MapRegistry)
      new=$(uint "${1:-}")
      [ "$new" != 0 ] || die "a quorum of zero would let a map pack be activated with a root nobody rebuilt"
      add_call "$MAPS" 'setRebuildQuorum(uint32)' "$new"
      TITLE="Set the map rebuild quorum to $new"
      LINES+=("Validators that must rebuild a map pack to the same root: $(q1 "$MAPS" 'rebuildQuorum()(uint32)') -> $new.")
      ;;
    map-grace)
      local MAPS
      MAPS=$(addr_of MapRegistry)
      seconds=$(to_seconds "${1:-}")
      add_call "$MAPS" 'setGracePeriod(uint64)' "$seconds"
      TITLE="Set the map grace period to $(duration "$seconds")"
      LINES+=("How long a map pack outlives its replacement: $(duration "$(q1 "$MAPS" 'gracePeriod()(uint64)')") -> $(duration "$seconds").")
      ;;
    verifier)
      local MAPS keys i
      MAPS=$(addr_of MapRegistry)
      keys=(endpointToleranceM distanceToleranceBps traceMarginM maxAccuracyM detourToleranceBps maxSpeedCmS maxAccelCmS2 maxHeadIntervalMs)
      qa cur "$MAPS" 'verifierParams()(uint32,uint32,uint32,uint32,uint32,uint32,uint32,uint32)'
      parse_kv "${keys[*]}" "$@"
      new=("${cur[@]}")
      TITLE="Change the proof verifier's tolerances"
      for i in "${!keys[@]}"; do
        [ -z "${KV[${keys[$i]}]:-}" ] || new[i]=$(uint "${KV[${keys[$i]}]}")
        LINES+=("  ${keys[$i]}: ${cur[$i]} -> ${new[$i]}")
      done
      add_call "$MAPS" 'setVerifierParams((uint32,uint32,uint32,uint32,uint32,uint32,uint32,uint32))' "($(IFS=,; echo "${new[*]}"))"
      WARNINGS+=("Jurors and phones must run a verifier with the same numbers (core/verify).")
      ;;
    release)
      build_release "$@"
      ;;
    call)
      local target
      target=$(resolve "${1:-}")
      [ -n "${2:-}" ] || die "request call <Contract | address> '<signature>' [args...]"
      shift
      add_call "$target" "$@"
      TITLE="Call ${1%%(*} on $(label "$target")"
      WARNINGS+=("A raw call. Members see it exactly as the lines under 'calls' here.")
      ;;
    *) die "'$what' is not something klippel-gov can request. See klippel-gov help" ;;
  esac
}

# ---------------------------------------------------------------- credentials

cmd_credential() {
  local kind_name=$1 action=${2:-} who REG kind c
  shift 2 || die "$kind_name approve | revoke <address>"
  REG=$(addr_of IdentityStore)
  kind=$(credential_kind "$kind_name")
  who=$(address "${1:-}")
  shift
  qa c "$REG" 'credentials(address,bytes32)(bytes32,address,uint64,bool)' "$who" "$kind"
  case "$action" in
    approve)
      local source=${1:-} expires=0 salt="" hash
      [ -n "$source" ] || die "$kind_name approve <address> <file | 0x hash> [--expires YYYY-MM-DD] [--salt 0x...]"
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --expires)
            expires=$(date -u -d "${2:-} 23:59:59" +%s 2>/dev/null) || die "'${2:-}' is not a date. Write it like 2031-05-20"
            shift 2
            ;;
          --salt) salt=${2:-}; shift 2 || die "--salt needs a value" ;;
          *) die "unknown option $1" ;;
        esac
      done
      [ "$(q1 "$REG" 'trustedAttester(address)(bool)' "$COUNCIL")" = true ] || die "the council $COUNCIL is not a trusted attester, so it cannot issue credentials. The board adds it with: klippel-gov request attester $COUNCIL on"
      [ "$(q1 "$REG" 'registeredAt(address)(uint64)' "$who")" != 0 ] || die "$who has not registered yet. A credential goes to a registered account"
      [ "$expires" = 0 ] || [ "$expires" -gt "$(now)" ] || die "that expiry date is in the past"
      if [[ $source =~ ^0x[0-9a-fA-F]{64}$ ]]; then
        [ -z "$salt" ] || die "--salt applies to a file, not to a hash that is already made"
        hash=$source
      else
        [ -f "$source" ] || die "'$source' is neither a file nor a 32-byte hash"
        [ -s "$source" ] || die "'$source' is empty"
        # Salted, so nobody can confirm a guess of the document by hashing it. Whoever holds the document and
        # the salt can show later that this is the one that was approved.
        [ -n "$salt" ] || salt=0x$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
        [[ $salt =~ ^0x[0-9a-fA-F]{64}$ ]] || die "the salt is 32 bytes, as 0x and 64 hex digits"
        # The file goes to cast on its input, never as an argument: an argument is capped in size and is
        # readable by every user of the machine while the command runs.
        local inner
        inner=$({ printf 0x; od -An -tx1 -v "$source" | tr -d ' \n'; } | cast keccak) || die "could not hash $source"
        [[ $inner =~ ^0x[0-9a-f]{64}$ ]] || die "could not hash $source"
        hash=$(cast keccak "$(cast concat-hex "$salt" "$inner")") || die "could not hash $source"
        [[ $hash =~ ^0x[0-9a-f]{64}$ ]] || die "could not hash $source"
      fi
      [ "$hash" != "$ZERO_32" ] || die "the hash cannot be zero"
      echo "Approve the $kind_name of $who, issued by the council"
      echo "  credential hash  $hash"
      [ -z "$salt" ] || echo "  salt             $salt   (keep it with the document: it is what proves this hash later)"
      echo "  expires          $(when "$expires")"
      if [ "${c[0]}" != "$ZERO_32" ] && [ "${c[1],,}" != "${COUNCIL,,}" ]; then
        local live
        live=$(q1 "$REG" 'hasCredential(address,bytes32)(bool)' "$who" "$kind")
        [ "$live" = false ] || die "$who holds a valid $kind_name from another attester, ${c[1]}. The contract does not let one attester replace another's valid credential"
        echo "  !! replaces the credential issued by $(label "${c[1]}"), which no longer counts"
      fi
      [ "$(q1 "$REG" 'blocked(address)(bool)' "$who")" = false ] || echo "  !! this account is blocked by governance: the credential will not let it accept rides"
      echo "  Only the hash goes on chain. The document stays with you and with the driver."
      add_call "$REG" 'attest(address,bytes32,bytes32,uint64)' "$who" "$kind" "$hash" "$expires"
      TITLE="Approve the $kind_name of $who"
      submit
      ;;
    revoke)
      [ "${c[0]}" != "$ZERO_32" ] || die "$who has no $kind_name credential"
      [ "${c[3]}" = false ] || die "the $kind_name credential of $who is already revoked"
      [ "${c[1],,}" = "${COUNCIL,,}" ] || die "that credential was issued by $(label "${c[1]}"), not by the council. Only its issuer revokes it; to stop that attester, the board requests: attester ${c[1]} off"
      add_call "$REG" 'revoke(address,bytes32)' "$who" "$kind"
      TITLE="Revoke the $kind_name of $who"
      LINES+=("It takes effect once the action runs: without a CNH a driver accepts no ride.")
      submit
      ;;
    *) die "$kind_name approve | revoke <address>" ;;
  esac
}

# ---------------------------------------------------------------- reading

cmd_account() {
  local who REG STK REP id st c kind entry sig stake d
  who=$(address "${1:-}")
  REG=$(addr_of IdentityStore)
  STK=$(addr_of StakeVault)
  REP=$(addr_of Reputation)
  stake=$(q1 "$STK" 'stakeToken()(address)')
  d=$(decimals_of "$stake")
  qa id "$REG" 'identity(address)((uint8,uint64))' "$who"
  qa st "$STK" 'stakeInfo(address)((uint256,uint256,uint64))' "$who"
  echo "Account $(label "$who")"
  if [ "${id[1]}" = 0 ]; then echo "  not registered"; else echo "  registered   $(when "${id[1]}") as $(roles_text "${id[0]}")"; fi
  # Each answer goes into a variable first, so a read that fails stops the command instead of printing "no".
  local is_blocked is_attester valid may
  is_blocked=$(q1 "$REG" 'blocked(address)(bool)' "$who")
  is_attester=$(q1 "$REG" 'trustedAttester(address)(bool)' "$who")
  echo "  blocked      $([ "$is_blocked" = true ] && echo 'YES, by governance' || echo no)"
  echo "  stake        $(brl "${st[0]}" "$d")$([ "${st[1]}" = 0 ] || echo ", and $(brl "${st[1]}" "$d") leaving from $(when "${st[2]}")")"
  echo "  rides        $(q1 "$REP" 'completedRides(address)(uint256)' "$who") completed"
  if [ "$(q1 "$REP" 'ratingCount(address)(uint256)' "$who")" = 0 ]; then echo "  score        not rated yet"
  else echo "  score        $(from_units "$(q1 "$REP" 'scoreOf(address)(uint256)' "$who")" 2) from $(q1 "$REP" 'ratingCount(address)(uint256)' "$who") ratings"; fi
  local r roles=()
  load_roles
  for r in "${!ROLE_NAMES[@]}"; do holds_role "$who" "$r" && roles+=("${ROLE_NAMES[$r]}") || true; done
  if [ ${#roles[@]} -gt 0 ]; then
    echo "  team         $(IFS=,; echo "${roles[*]}" | sed 's/,/, /g')$([ "$(q1 "$COUNCIL" 'suspended(address)(bool)' "$who")" = false ] || echo ', SUSPENDED')"
  fi
  [ "$is_attester" = false ] || echo "  attester     trusted: may issue and revoke credentials"
  for kind in CNH KYC; do
    qa c "$REG" 'credentials(address,bytes32)(bytes32,address,uint64,bool)' "$who" "$(credential_kind "$kind")"
    if [ "${c[0]}" = "$ZERO_32" ]; then echo "  $kind          none"
    else
      valid=$(q1 "$REG" 'hasCredential(address,bytes32)(bool)' "$who" "$(credential_kind "$kind")")
      echo "  $kind          $([ "$valid" = true ] && echo valid || echo 'NOT VALID')$([ "${c[3]}" = false ] || echo ', revoked'), issued by $(label "${c[1]}"), expires $(when "${c[2]}")"
    fi
  done
  echo "  may call"
  for entry in "${POLICIES[@]}"; do
    sig=${entry#*|}
    may=$(q1 "$GOV" 'hasPermission(address,address,bytes4)(bool)' "$who" "$(addr_of "${entry%%.*}")" "$(cast sig "$sig")")
    printf '    %-22s %s\n' "${entry%%|*}" "$([ "$may" = true ] && echo yes || echo no)"
  done
}

cmd_status() {
  local REG STK REP REL ESC VAULT COURT MAPS FARES name a v stake d key entry sig problems=0
  REG=$(addr_of IdentityStore) STK=$(addr_of StakeVault) REP=$(addr_of Reputation) REL=$(addr_of ReleaseRegistry)
  ESC=$(addr_of RideEscrow) VAULT=$(addr_of FeeVault)
  COURT=$(addr_of DisputeCourt) MAPS=$(addr_of MapRegistry) FARES=$(addr_of FareGuide)
  stake=$(q1 "$STK" 'stakeToken()(address)')
  d=$(decimals_of "$stake")

  echo "KlippelGo on chain $CHAIN ($RPC), addresses from $DEPLOYMENT"
  # Limit L11: the deployer can do anything until the bootstrap ends.
  if [ "$(q1 "$GOV" 'bootstrapper()(address)')" != "$ZERO_ADDRESS" ]; then
    echo "  !! THE BOOTSTRAP IS STILL OPEN: $(q1 "$GOV" 'bootstrapper()(address)') can change anything without a vote"
    problems=1
  fi
  for name in "${CONTRACTS[@]:1}"; do
    a=$(addr_of "$name")
    if [ "$(q1 "$a" 'governor()(address)')" != "$GOV" ]; then echo "  !! $name at $a answers to another governor"; problems=1; fi
  done
  local guardian pending
  guardian=$(q1 "$GOV" 'guardian()(address)')
  pending=$(q1 "$GOV" 'pendingGuardian()(address)')
  if [ "${guardian,,}" != "${COUNCIL,,}" ]; then
    echo "  !! THE GUARDIAN IS $(label "$guardian"), NOT THE TEAM COUNCIL $COUNCIL"
    problems=1
  fi
  if [ "$pending" != "$ZERO_ADDRESS" ]; then
    echo "  !! A HANDOVER OF THE GUARDIAN'S SEAT IS WAITING: $(label "$pending") becomes guardian the moment it accepts"
    problems=1
  fi
  [ "$(q1 "$REG" 'trustedAttester(address)(bool)' "$COUNCIL")" = true ] || echo "  !! the council is not a trusted attester: it cannot issue licences"
  # The data the policies read, and the code this deployment file's release writes it with.
  local wired
  wired=$(q1 "$GOV" 'identities()(address)'),$(q1 "$GOV" 'stakes()(address)'),$(q1 "$GOV" 'reputation()(address)')
  if [ "${wired,,}" != "${REG,,},${STK,,},${REP,,}" ]; then
    echo "  !! the governor reads identities, stake or reputation from contracts other than this deployment file's"
    problems=1
  fi
  [ "$(q1 "$REG" 'writers(address)(bool)' "$(addr_of IdentityRegistry)")" = true ] || echo "  !! this deployment file's IdentityRegistry may not write the identities: nobody can register through it"
  [ "$(q1 "$REP" 'writers(address)(bool)' "$ESC")" = true ] || echo "  !! this deployment file's RideEscrow may not write reputation: its rides do not count"
  [ "$problems" = 1 ] || echo "  The bootstrap is closed, every contract answers to the governor at $GOV, and its guardian is the team council."

  echo "Governance"
  load_roles
  echo "  guardian          $(label "$guardian")"
  echo "  roles             $(for r in "${!ROLE_NAMES[@]}"; do printf '%s (%s) ' "${ROLE_NAMES[$r]}" "${ROLE_MEMBERS[$r]}"; done)"
  local count pending_actions=0 i st
  count=$(q1 "$COUNCIL" 'actionCount()(uint256)')
  for ((i = count - 1; i >= 0 && i >= count - 50; i--)); do
    st=$(cast call --json --rpc-url "$RPC" "$COUNCIL" "$ACTION_SIG" "$i" | jq -r 'if type == "object" then .data else . end | .[0][1] | tostring')
    [ "$st" != 1 ] || pending_actions=$((pending_actions + 1))
  done
  echo "  actions           $count, $pending_actions of the last 50 pending (klippel-gov actions)"
  echo "  unbonding period  $(duration "$(q1 "$STK" 'unbondingPeriod()(uint64)')")"

  echo "Releases"
  local latest mine
  latest=$(q1 "$REL" 'latest()(uint48)')
  if [ "$latest" = 0 ]; then echo "  none published"
  else echo "  latest            $(version_text "$latest"), $(release_status "$latest")"; fi
  mine=$(jq -r '.version // empty' "$DEPLOYMENT")
  if [ -n "$mine" ]; then
    local packed
    packed=$(version_pack "$mine")
    echo "  this file's       $mine, $(release_status "$packed")$([ "$(release_matches "$packed")" = true ] || echo '; its code contracts are NOT the ones published')"
  fi

  echo "Money"
  echo "  tax               $(percent "$(q1 "$ESC" 'taxBps()(uint16)')") of each fare, to $(label "$(q1 "$ESC" 'taxCollector()(address)')")"
  echo "  fee beneficiary   $(label "$(q1 "$VAULT" 'beneficiary()(address)')")"
  for key in $(jq -r 'to_entries[] | select(.key | test("^BR")) | .key' "$DEPLOYMENT"); do
    a=$(addr_of "$key")
    qa v "$ESC" 'tokenConfig(address)(uint256,uint256,uint256)' "$a"
    local td
    td=$(decimals_of "$a")
    if [ "${v[0]}" = 0 ]; then printf '  %-17s not on the allow-list\n' "$key"
    else
      local cap
      cap=$(q1 "$ESC" 'cap(address)(uint256)' "$a")
      printf '  %-17s fee %s, rider bond %s, driver bond %s; %s waiting in the vault\n' "$key" "$(brl "${v[0]}" "$td")" "$(brl "${v[1]}" "$td")" "$(brl "${v[2]}" "$td")" "$(brl "$(q1 "$a" 'balanceOf(address)(uint256)' "$VAULT")" "$td")"
      printf '  %-17s escrow holds %s of a cap of %s\n' "" "$(brl "$(q1 "$ESC" 'held(address)(uint256)' "$a")" "$td")" "$([ "$cap" = 0 ] && echo 'no limit' || brl "$cap" "$td")"
    fi
  done
  echo "  native coin       $(brl "$(q1 "$FARES" 'nativeCoinCentavos()(uint256)')" 2)"

  echo "Tariff"
  qa v "$FARES" 'tariff()(uint32,uint32,uint32,uint32,uint16,uint16)'
  echo "  $(brl "${v[0]}" 2) + $(brl "${v[1]}" 2) per km + $(brl "${v[2]}" 2) per minute, never under $(brl "${v[3]}" 2)"
  echo "  riders may ask $(percent "${v[4]}") either side; drivers may quote $(percent "${v[5]}") under the rider's price"

  echo "Rides and disputes"
  echo "  completion timeout  $(duration "$(q1 "$ESC" 'completionTimeout()(uint64)')") for rides opened from now on"
  echo "  dispute             commit $(duration "$(q1 "$COURT" 'commitPeriod()(uint64)')"), reveal $(duration "$(q1 "$COURT" 'revealPeriod()(uint64)')")"

  echo "Maps"
  echo "  rebuild quorum    $(q1 "$MAPS" 'rebuildQuorum()(uint32)') validators"
  echo "  grace period      $(duration "$(q1 "$MAPS" 'gracePeriod()(uint64)')")"
  qa v "$MAPS" 'verifierParams()(uint32,uint32,uint32,uint32,uint32,uint32,uint32,uint32)'
  echo "  verifier          endpoint ${v[0]} m, distance ${v[1]} bps, trace margin ${v[2]} m, accuracy ${v[3]} m, detour ${v[4]} bps, speed ${v[5]} cm/s, acceleration ${v[6]} cm/s2, head interval ${v[7]} ms"

  echo "Policies"
  for entry in "${POLICIES[@]}"; do
    sig=${entry#*|}
    qa v "$GOV" 'policy(address,bytes4)((bool,uint8,uint16,uint32,uint256,bytes32))' "$(addr_of "${entry%%.*}")" "$(cast sig "$sig")"
    if [ "${v[0]}" != true ]; then printf '  %-22s disabled: nobody may call it\n' "${entry%%|*}"; continue; fi
    printf '  %-22s roles %s; score %s; age %s; stake %s; credential %s\n' "${entry%%|*}" \
      "$(roles_text "${v[1]}")" "$(from_units "${v[2]}" 2)" "$(duration "${v[3]}")" "$(brl "${v[4]}" "$d")" "$(credential_name "${v[5]}")"
  done
  return "$problems"
}

# ---------------------------------------------------------------- releases

# version_pack 1.2.3: the way ReleaseRegistry keys a release, major << 32 | minor << 16 | patch.
version_pack() {
  [[ $1 =~ ^([0-9]{1,5})\.([0-9]{1,5})\.([0-9]{1,5})$ ]] || die "'$1' is not a version. Write it like 1.2.3"
  local a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]})) c=$((10#${BASH_REMATCH[3]}))
  [ "$a" -lt 65536 ] && [ "$b" -lt 65536 ] && [ "$c" -lt 65536 ] || die "each part of '$1' is under 65536"
  echo $(((a << 32) | (b << 16) | c))
}

version_text() { echo "$(($1 >> 32)).$((($1 >> 16) & 65535)).$(($1 & 65535))"; }

release_status() { echo "${RELEASE_STATUS[$(q1 "$(addr_of ReleaseRegistry)" 'statusOf(uint48)(uint8)' "$1")]}"; }

# The contracts hash of the code contracts in the deployment file, as ReleaseRegistry computes it.
release_code_hash() {
  local args=() name
  for name in "${RELEASE_CODE[@]}"; do args+=("$(addr_of "$name")"); done
  q1 "$(addr_of ReleaseRegistry)" 'contractsHash(address,address,address,address,address,address)(bytes32)' "${args[@]}"
}

# true if the release published at this version is made of the deployment file's code contracts.
release_matches() {
  local r
  qa r "$(addr_of ReleaseRegistry)" 'release(uint48)((bytes32,uint8,uint64))' "$1"
  [ "${r[0]}" = "$(release_code_hash)" ] && echo true || echo false
}

build_release() {
  local REL action=${1:-} version packed status
  REL=$(addr_of ReleaseRegistry)
  [ -n "${2:-}" ] || die "request release publish | deprecate | revoke | reinstate <version>"
  version=$2
  packed=$(version_pack "$version")
  shift 2
  status=$(release_status "$packed")
  case "$action" in
    publish)
      [ "$status" = none ] || die "$version is published already ($status). A fix is a new version"
      local code apks=() source h name
      code=$(release_code_hash)
      for source in "$@"; do
        if [[ $source =~ ^0x[0-9a-fA-F]{64}$ ]]; then h=${source,,}
        else
          [ -f "$source" ] || die "'$source' is neither an APK file nor a 32-byte SHA-256"
          h=0x$(sha256sum "$source" | cut -d' ' -f1)
        fi
        apks+=("$h")
      done
      [ ${#apks[@]} -le 8 ] || die "a release names 8 APKs at most"
      add_call "$REL" 'publish(uint48,bytes32,bytes32[])' "$packed" "$code" "$(join "${apks[@]}")"
      TITLE="Publish release $version"
      LINES+=("Apps built at version $version with these code contracts may run; apps on earlier releases are offered it.")
      for name in "${RELEASE_CODE[@]}"; do LINES+=("  $(printf '%-17s' "$name") $(addr_of "$name")"); done
      LINES+=("  contracts hash    $code")
      for h in "${apks[@]}"; do LINES+=("  APK sha-256       $h"); done
      LINES+=("Each director builds the tag and checks the addresses and every APK hash above before approving.")
      [ ${#apks[@]} -gt 0 ] || WARNINGS+=("No APK named: phones cannot check an update to this release they download.")
      local i
      for ((i = 0; i < ${#apks[@]}; i++)); do
        [ "$(q1 "$REL" 'isApk(uint48,bytes32)(bool)' "$(q1 "$REL" 'latest()(uint48)')" "${apks[$i]}")" = false ] \
          || WARNINGS+=("${apks[$i]} is an APK of the latest release already: the same build under a new version?")
      done
      WARNINGS+=("This release's escrow needs its own playbook, named revoke-release-$version, with revoke($packed) and stop-rides on its escrow: the board stores it with grantPlaybook once this runs. Store new stop-rides and resume-rides for its escrow too: the launch ones name the launch escrow.")
      ;;
    deprecate)
      [ "$status" = active ] || die "$version is $status, not active"
      add_call "$REL" 'deprecate(uint48)' "$packed"
      TITLE="Deprecate release $version"
      LINES+=("Apps on $version keep working and ask their users to update.")
      ;;
    revoke)
      [ "$status" = active ] || [ "$status" = deprecated ] || die "$version is $status: only an active or deprecated release is revoked"
      add_call "$REL" 'revoke(uint48)' "$packed"
      TITLE="Revoke release $version"
      LINES+=("Apps on $version let a ride under way finish and money be withdrawn, and start no new ride.")
      WARNINGS+=("This stops honest apps only. The release's escrow stays open to any other app: the playbook revoke-release-$version closes it in the same action, and once this runs that playbook can no longer run (the release is revoked already): use stop-rides for its escrow then.")
      ;;
    reinstate)
      [ "$status" = deprecated ] || [ "$status" = revoked ] || die "$version is $status: only a deprecated or revoked release is put back"
      add_call "$REL" 'reinstate(uint48)' "$packed"
      TITLE="Put release $version back"
      LINES+=("Apps on $version work again as on an active release.")
      ;;
    *) die "request release publish | deprecate | revoke | reinstate <version>" ;;
  esac
}

cmd_release() {
  local REL logs n i v code apks status r latest
  REL=$(addr_of ReleaseRegistry)
  latest=$(q1 "$REL" 'latest()(uint48)')
  logs=$(cast logs --json --rpc-url "$RPC" --from-block "$FROM_BLOCK" --address "$REL" 'Published(uint48,bytes32,bytes32[])') \
    || die "could not read the release registry's events. If the node limits how far back it searches, set KLIPPEL_GOV_FROM_BLOCK"
  n=$(jq 'length' <<<"$logs")
  if [ -z "${1:-}" ]; then
    [ "$n" != 0 ] || { echo "No release published since block $FROM_BLOCK."; return; }
    for ((i = 0; i < n; i++)); do
      v=$(cast to-dec "$(jq -r ".[$i].topics[1]" <<<"$logs")")
      qa r "$REL" 'release(uint48)((bytes32,uint8,uint64))' "$v"
      printf '  %-10s %-11s published %s%s\n' "$(version_text "$v")" "${RELEASE_STATUS[${r[1]}]}" "$(when "${r[2]}")" "$([ "$v" != "$latest" ] || echo ', latest')"
    done
    return
  fi
  v=$(version_pack "$1")
  qa r "$REL" 'release(uint48)((bytes32,uint8,uint64))' "$v"
  [ "${r[1]}" != 0 ] || die "release $1 is not published"
  echo "Release $1: ${RELEASE_STATUS[${r[1]}]}, published $(when "${r[2]}")$([ "$v" != "$latest" ] || echo ', the latest')"
  echo "  contracts hash    ${r[0]}"
  local name ours
  ours=$(release_code_hash)
  echo "  $DEPLOYMENT's code contracts $([ "$ours" = "${r[0]}" ] && echo 'are this release:' || echo 'are NOT this release:')"
  for name in "${RELEASE_CODE[@]}"; do printf '    %-17s %s\n' "$name" "$(addr_of "$name")"; done
  for ((i = 0; i < n; i++)); do
    [ "$(cast to-dec "$(jq -r ".[$i].topics[1]" <<<"$logs")")" = "$v" ] || continue
    mapfile -t apks < <(cast decode-abi --json 'f()(bytes32,bytes32[])' "$(jq -r ".[$i].data" <<<"$logs")" \
      | jq -r 'if type == "object" then .data else . end | .[1] | if type == "string" then (ltrimstr("[") | rtrimstr("]") | split(", ") | .[]) else .[] end | select(. != "")')
    if [ ${#apks[@]} -eq 0 ]; then echo "  APKs              none named"
    else for code in "${apks[@]}"; do echo "  APK sha-256       $code"; done; fi
  done
  echo "  Check: build the tag, compare each APK's sha256sum with the lines above."
}

cmd_sweep() {
  local VAULT token d amount
  VAULT=$(addr_of FeeVault)
  token=$(resolve "${1:-}")
  d=$(decimals_of "$token")
  amount=$(q1 "$token" 'balanceOf(address)(uint256)' "$VAULT")
  [ "$amount" != 0 ] || { echo "The vault holds nothing in $(label "$token")."; return; }
  need_wallet
  echo "Send $(brl "$amount" "$d") from the vault to the beneficiary, $(q1 "$VAULT" 'beneficiary()(address)')."
  confirm
  send "$VAULT" 'sweep(address)' "$token" >/dev/null
  ! prepared || return 0
  echo "Sent."
}

# ---------------------------------------------------------------- main

RPC=${KLIPPEL_GOV_RPC:-http://127.0.0.1:8545}
DEPLOYMENT=${KLIPPEL_GOV_DEPLOYMENT:-$(dirname "$0")/../deployments/local.json}
YES=0
# Set but empty is a mistake in whoever set it, and must not quietly mean "sign with a key".
[ -z "${KLIPPEL_GOV_SAFE+set}" ] || [ -n "$KLIPPEL_GOV_SAFE" ] || die "KLIPPEL_GOV_SAFE is set but empty"
SAFE=${KLIPPEL_GOV_SAFE:-}
# What a prepared transaction is reported on: the terminal, even where a caller discards a receipt.
exec 3>&1
while [ $# -gt 0 ]; do
  case "$1" in
    --rpc) RPC=${2:-}; shift 2 || die "--rpc needs a URL" ;;
    --deployment) DEPLOYMENT=${2:-}; shift 2 || die "--deployment needs a file" ;;
    --yes) YES=1; shift ;;
    --safe)
      # An empty value must not quietly turn into signing with a key.
      [ -n "${2:-}" ] || die "--safe needs an address"
      SAFE=$2
      shift 2
      ;;
    *) break ;;
  esac
done
COMMAND=${1:-help}
shift || true
# An option after the command would be ignored, and "--safe" ignored means a transaction sent with a key.
for arg in "$@"; do
  case "$arg" in --safe | --safe=* | --yes | --yes=* | --rpc | --rpc=* | --deployment | --deployment=*) die "${arg%%=*} goes before the command, with its value after a space: klippel-gov ${arg%%=*} ... $COMMAND ..." ;; esac
done
case "$COMMAND" in help | -h | --help) usage; exit 0 ;; esac

command -v cast >/dev/null || die "needs Foundry's cast: https://book.getfoundry.sh/getting-started/installation"
command -v jq >/dev/null || die "needs jq"
[ -f "$DEPLOYMENT" ] || die "no deployment file at $DEPLOYMENT"
CHAIN=$(cast chain-id --rpc-url "$RPC" 2>/dev/null) || die "no chain node at $RPC"
# The addresses mean something on one chain only. On another they may be anyone's.
[ "$(jq -r '.chainId' "$DEPLOYMENT")" = "$CHAIN" ] || die "$DEPLOYMENT is for chain $(jq -r '.chainId' "$DEPLOYMENT"), and $RPC is chain $CHAIN"
GOV=$(addr_of PBACGovernor)
[ "$(cast code --rpc-url "$RPC" "$GOV")" != 0x ] || die "there is no contract at the governor's address $GOV on chain $CHAIN"
if [ -n "$SAFE" ]; then
  SAFE=$(address "$SAFE")
  # An address with no contract is not a multisig. Acting "as" it would prepare transactions nobody can approve.
  [ "$(cast code --rpc-url "$RPC" "$SAFE")" != 0x ] || die "$SAFE is not a contract on chain $CHAIN, so it is not a multisig"
  # What the contract says of itself, as the node reports it: enough to catch a mistyped address, not proof
  # that it is a sound multisig. It goes to the error stream, so it stays out of anything piped.
  if THRESHOLD=$(cast call --rpc-url "$RPC" "$SAFE" 'getThreshold()(uint256)' 2>/dev/null) \
    && OWNERS=$(cast call --json --rpc-url "$RPC" "$SAFE" 'getOwners()(address[])' 2>/dev/null); then
    THRESHOLD=${THRESHOLD%% *}
    OWNERS=$(jq 'if type == "object" then .data else . end | [.. | scalars] | length' <<<"$OWNERS")
    echo "Acting as $SAFE, which reports a threshold of $THRESHOLD and $OWNERS owners." >&2
    [ "$THRESHOLD" -ge 2 ] || echo "!! With a threshold under 2, one key acts alone: this is not a multisig in anything but name." >&2
    [ "$OWNERS" -ge "$THRESHOLD" ] && [ "$OWNERS" -gt 0 ] || echo "!! It reports fewer owners than its threshold. It may not be set up, and whoever sets it up owns it." >&2
  else
    echo "Acting as the contract $SAFE. It does not answer as a Safe does: check that it is the multisig you mean." >&2
  fi
fi
COUNCIL=$(addr_of TeamCouncil)
[ "$(cast code --rpc-url "$RPC" "$COUNCIL")" != 0x ] || die "there is no contract at the team council's address $COUNCIL on chain $CHAIN"
FROM_BLOCK=${KLIPPEL_GOV_FROM_BLOCK:-$(jq -r '.deployBlock // 0' "$DEPLOYMENT")}


case "$COMMAND" in
  status) cmd_status ;;
  account) cmd_account "$@" ;;
  actions) cmd_actions "$@" ;;
  action) show_action "${1:-}" ;;
  approve) cmd_approve "$@" ;;
  cancel) cmd_cancel "$@" ;;
  execute) cmd_execute "$@" ;;
  request) need_wallet; build_request "$@"; TITLE="Request: $TITLE"; submit ;;
  block | unblock) need_wallet; build_request "$COMMAND" "$@"; TITLE="Request: $TITLE"; submit ;;
  playbooks) cmd_playbooks ;;
  release) cmd_release "$@" ;;
  run) cmd_run "$@" ;;
  stop-rides | resume-rides) cmd_run "$COMMAND" ;;
  team)
    case "${1:-}" in
      "" | show) cmd_team_show ;;
      *) need_wallet; build_team "$@"; TITLE="Request: $TITLE"; submit ;;
    esac
    ;;
  cnh) cmd_credential CNH "$@" ;;
  kyc) cmd_credential KYC "$@" ;;
  sweep) cmd_sweep "$@" ;;
  propose | vote | queue | register) die "'$COMMAND' is gone: governance is the team council now. See klippel-gov help" ;;
  *) die "'$COMMAND' is not a command. See klippel-gov help" ;;
esac
